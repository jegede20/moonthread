# Groq API key - get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional: override model (must be available on Groq free tier)
# As of Aug 16 2026, Llama models are decommissioned on free tier.
# Use one of these:
# GROQ_MODEL=openai/gpt-oss-20b          # fast, recommended (1000 tok/s)
# GROQ_MODEL=openai/gpt-oss-120b         # higher quality
# GROQ_MODEL=qwen/qwen3-32b  (or qwen/qwen3-8b etc depending on availability)
# GROQ_MODEL=openai/gpt-oss-20b is default
